<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.Beheer.ItemsManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:localdata="using:DreamScape_Interactive.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

 <Grid.ColumnDefinitions>
   <ColumnDefinition Width="250"/>
        <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#1F2937">
    <StackPanel Margin="20">

 <StackPanel Margin="0,0,0,40">
  <TextBlock Text="?? DreamScape"
         FontSize="24"
            FontWeight="Bold"
        Foreground="White"/>
                <TextBlock Text="Admin Panel"
          FontSize="12"
         Foreground="#9CA3AF"
           Margin="0,5,0,0"/>
            </StackPanel>

        <Button Content="?? Dashboard"
        Margin="0,5"
     Padding="15,12"
           Background="#374151"
           Foreground="White"
      CornerRadius="8"
            FontWeight="SemiBold"
   BorderThickness="0"
  Click="BeheerOverviewButton_Click">
     <Button.Resources>
           <ResourceDictionary>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
             <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
           </ResourceDictionary>
        </Button.Resources>
          </Button>

         <Button Content="?? Gebruikers"
           Margin="0,5"
            Padding="15,12"
        Background="#374151"
          Foreground="White"
    CornerRadius="8"
     FontWeight="SemiBold"
     BorderThickness="0"
           Click="UserButton_Click">
      <Button.Resources>
  <ResourceDictionary>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
              <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
           </ResourceDictionary>
       </Button.Resources>
       </Button>

     <Button Content="?? Items"
      Margin="0,5"
         Padding="15,12"
  Background="#10B981"
              Foreground="White"
          CornerRadius="8"
    FontWeight="SemiBold"
 BorderThickness="0"
        Click="ItemsButton_Click">
         <Button.Resources>
            <ResourceDictionary>
         <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
  <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
        </ResourceDictionary>
  </Button.Resources>
       </Button>

     <Button Content="?? Trades"
  Margin="0,5"
                  Padding="15,12"
     Background="#374151"
  Foreground="White"
       CornerRadius="8"
      FontWeight="SemiBold"
  BorderThickness="0"
    Click="TradesButton_Click">
      <Button.Resources>
           <ResourceDictionary>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
       <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
       </ResourceDictionary>
     </Button.Resources>
       </Button>

      <Button x:Name="Logout"
     Content="?? Uitloggen"
    Margin="0,60,0,0"
   Padding="15,12"
        Background="#EF4444"
        Foreground="White"
   CornerRadius="8"
     FontWeight="SemiBold"
     BorderThickness="0"
    Click="Logout_Click">
      <Button.Resources>
   <ResourceDictionary>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
           <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
     </ResourceDictionary>
   </Button.Resources>
                </Button>

            </StackPanel>
    </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">

          <Grid.RowDefinitions>
      <RowDefinition Height="80"/>
    <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

      <!-- Topbar -->
            <Grid Background="#1F2937" Padding="30,0">
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

       <TextBlock Text="?? Items Management"
 FontSize="28"
  FontWeight="Bold"
          Foreground="White"
           VerticalAlignment="Center"/>

          <Button Content="? Add New Item"
          Grid.Column="1"
            Background="#10B981"
        Foreground="White"
        Padding="20,12"
          CornerRadius="8"
           FontWeight="SemiBold"
            Click="AddItemButton_Click">
           <Button.Resources>
          <ResourceDictionary>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
        </ResourceDictionary>
            </Button.Resources>
                </Button>
      </Grid>

            <!-- Filter Tabs -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="30,20,30,10" Spacing="10">
    <Button x:Name="AllItemsTab"
           Content="?? All Items"
         Background="#10B981"
        Foreground="White"
    Padding="15,10"
     CornerRadius="8"
  Click="AllItemsTab_Click"/>

                <Button x:Name="WeaponsTab"
     Content="?? Weapons"
       Background="#374151"
                Foreground="White"
     Padding="15,10"
       CornerRadius="8"
      Click="WeaponsTab_Click"/>

    <Button x:Name="ArmorTab"
           Content="??? Armor"
           Background="#374151"
       Foreground="White"
          Padding="15,10"
     CornerRadius="8"
            Click="ArmorTab_Click"/>

     <TextBox x:Name="ItemSearchBox"
PlaceholderText="?? Search items..."
           Background="#1F2937"
    Foreground="White"
   BorderBrush="#374151"
          BorderThickness="2"
             CornerRadius="8"
    Height="44"
        Width="300"
        Padding="12,8"
              Margin="20,0,0,0"
      TextChanged="ItemSearchBox_TextChanged"/>
            </StackPanel>

       <!-- Items List -->
       <ScrollViewer Grid.Row="2" Margin="30,0,30,30">
      <ListView x:Name="ItemsListView"
         Background="Transparent"
  SelectionMode="None">
         <ListView.ItemTemplate>
            <DataTemplate x:DataType="localdata:Item">
            <Border Background="#1F2937"
                  CornerRadius="12"
         BorderThickness="2"
        BorderBrush="#374151"
         Padding="20"
             Margin="0,0,0,15">

             <Grid>
             <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>

 <!-- Item Icon -->
        <Border Background="#374151"
          CornerRadius="12"
                Width="70"
    Height="70">
        <TextBlock Text="??"
          FontSize="36"
         HorizontalAlignment="Center"
 VerticalAlignment="Center"/>
        </Border>

           <!-- Item Details -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
    <TextBlock Text="{Binding Name}"
            Foreground="White"
   FontSize="20"
                FontWeight="Bold"/>

         <TextBlock Text="{Binding Description}"
             Foreground="#9CA3AF"
  FontSize="13"
         TextWrapping="Wrap"
         Margin="0,5,0,10"/>

     <Grid>
    <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
   <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

     <!-- Type -->
<Border Background="#111827"
        CornerRadius="6"
         Padding="10,5"
         Margin="0,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="5">
        <TextBlock Text="???" FontSize="12"/>
       <TextBlock Text="{Binding Type}"
      Foreground="#60A5FA"
               FontSize="12"
          FontWeight="SemiBold"/>
   </StackPanel>
         </Border>

          <!-- Rarity -->
            <Border Background="#111827"
       CornerRadius="6"
             Padding="10,5"
       Margin="0,0,10,0"
               Grid.Column="1">
      <StackPanel Orientation="Horizontal" Spacing="5">
             <TextBlock Text="?" FontSize="12"/>
              <TextBlock Text="{Binding Rarity}"
        Foreground="#FBBF24"
         FontSize="12"
      FontWeight="SemiBold"/>
   </StackPanel>
            </Border>

                <!-- Strength -->
    <Border Background="#111827"
    CornerRadius="6"
Padding="10,5"
   Margin="0,0,10,0"
  Grid.Column="2">
         <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="??" FontSize="12"/>
 <TextBlock Text="{Binding strength}"
  Foreground="#EF4444"
    FontSize="12"
      FontWeight="SemiBold"/>
   </StackPanel>
         </Border>

           <!-- Speed -->
  <Border Background="#111827"
           CornerRadius="6"
   Padding="10,5"
         Margin="0,0,10,0"
            Grid.Column="3">
  <StackPanel Orientation="Horizontal" Spacing="5">
 <TextBlock Text="?" FontSize="12"/>
    <TextBlock Text="{Binding Speed}"
Foreground="#10B981"
   FontSize="12"
          FontWeight="SemiBold"/>
</StackPanel>
         </Border>

               <!-- Durability -->
      <Border Background="#111827"
     CornerRadius="6"
            Padding="10,5"
     Margin="0,0,10,0"
  Grid.Column="4">
  <StackPanel Orientation="Horizontal" Spacing="5">
             <TextBlock Text="???" FontSize="12"/>
             <TextBlock Text="{Binding Durability}"
             Foreground="#60A5FA"
     FontSize="12"
          FontWeight="SemiBold"/>
       </StackPanel>
   </Border>

            <!-- Magic Effect -->
       <Border Background="#111827"
       CornerRadius="6"
           Padding="10,5"
    Grid.Column="5">
            <StackPanel Orientation="Horizontal" Spacing="5">
      <TextBlock Text="?" FontSize="12"/>
        <TextBlock Text="{Binding Magic_Effect}"
        Foreground="#A78BFA"
  FontSize="12"
               FontWeight="SemiBold"/>
          </StackPanel>
   </Border>
     </Grid>
</StackPanel>

                <!-- Actions -->
             <StackPanel Grid.Column="2" Spacing="10">
            <Button Content="?? Edit"
              Background="#2563EB"
       Foreground="White"
           Padding="15,8"
              MinWidth="100"
                 CornerRadius="6"
   FontWeight="SemiBold"
 Tag="{Binding}"
         Click="EditItemButton_Click">
    <Button.Resources>
              <ResourceDictionary>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>
                </ResourceDictionary>
  </Button.Resources>
        </Button>

           <Button Content="??? Delete"
       Background="#EF4444"
   Foreground="White"
   Padding="15,8"
        MinWidth="100"
       CornerRadius="6"
    FontWeight="SemiBold"
Tag="{Binding}"
    Click="DeleteItemButton_Click">
     <Button.Resources>
          <ResourceDictionary>
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
      </ResourceDictionary>
        </Button.Resources>
        </Button>
             </StackPanel>

             </Grid>
       </Border>
  </DataTemplate>
        </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
