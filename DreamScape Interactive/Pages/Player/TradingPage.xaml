<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.Player.TradingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

        <Grid.RowDefinitions>
       <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
 </Grid.RowDefinitions>

        <!-- TOPBAR -->
 <Grid Background="#1F2937">
            <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
         <ColumnDefinition Width="*"/>
         </Grid.ColumnDefinitions>

            <!-- Back Button -->
         <Button Content="? Back"
       Background="#374151"
        Foreground="White"
    Margin="20,0,0,0"
   Padding="15,8"
    VerticalAlignment="Center"
    FontSize="14"
     FontWeight="SemiBold"
                CornerRadius="8"
      Click="BackButton_Click">
        <Button.Resources>
        <ResourceDictionary>
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
      </ResourceDictionary>
                </Button.Resources>
            </Button>

       <TextBlock Text="?? Trading Hub"
        Grid.Column="1"
        FontSize="28"
         FontWeight="Bold"
      Foreground="White"
       VerticalAlignment="Center"
       Margin="20,0"/>
     </Grid>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="20">
 <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SEARCH PLAYERS SECTION -->
    <Border Background="#1F2937"
       CornerRadius="12"
   BorderThickness="2"
   BorderBrush="#374151"
         Padding="20">
          <Grid>
          <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
             <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
  </Grid.RowDefinitions>

             <TextBlock Text="Find Players to Trade With"
                FontSize="20"
   FontWeight="Bold"
  Foreground="White"
     Margin="0,0,0,5"/>

            <TextBlock Text="Players are sorted by level (highest first)"
         Foreground="#9CA3AF"
      FontSize="12"
  Margin="0,0,0,10"/>

 <!-- Search Box -->
   <TextBox x:Name="PlayerSearchBox"
         Grid.Row="1"
           PlaceholderText="?? Search players..."
            Background="#111827"
             Foreground="White"
           BorderBrush="#374151"
     BorderThickness="2"
              CornerRadius="8"
  Height="44"
   Padding="12,8"
      Margin="0,0,0,15"
  TextChanged="PlayerSearchBox_TextChanged"/>

     <!-- Players List -->
         <ListView x:Name="PlayersListView"
       Grid.Row="2"
       Background="Transparent"
      SelectionMode="None">
          <ListView.ItemTemplate>
      <DataTemplate>
    <Border Background="#111827"
       CornerRadius="8"
      Padding="15"
     Margin="0,0,0,10">
   <Grid>
       <Grid.ColumnDefinitions>
 <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="Auto"/>
 <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

   <StackPanel>
      <TextBlock Text="{Binding Username}"
Foreground="White"
  FontSize="16"
     FontWeight="Bold"/>
     <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,8,0,0">
    <StackPanel Orientation="Horizontal" Spacing="5">
     <TextBlock Text="?" FontSize="14"/>
  <TextBlock Text="{Binding Level}"
        Foreground="#FBBF24"
       FontSize="14"
    FontWeight="SemiBold"/>
         </StackPanel>
  <TextBlock Text="|" Foreground="#6B7280"/>
    <StackPanel Orientation="Horizontal" Spacing="5">
       <TextBlock Text="?" FontSize="14"/>
  <TextBlock Text="{Binding TotalXP}"
       Foreground="#10B981"
FontSize="14"
         FontWeight="SemiBold"/>
   <TextBlock Text="XP" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0"/>
</StackPanel>
       <TextBlock Text="|" Foreground="#6B7280"/>
    <StackPanel Orientation="Horizontal" Spacing="5">
      <TextBlock Text="??" FontSize="14"/>
         <TextBlock Text="{Binding TradesCount}"
        Foreground="#60A5FA"
FontSize="14"
    FontWeight="SemiBold"/>
  </StackPanel>
     </StackPanel>
       </StackPanel>

     <TextBlock Text="{Binding Email}"
          Grid.Column="1"
       Foreground="#9CA3AF"
   FontSize="12"
    VerticalAlignment="Center"
      Margin="0,0,15,0"/>

     <Button Content="Trade"
      Grid.Column="2"
          Background="#10B981"
     Foreground="White"
   Padding="15,8"
   CornerRadius="8"
     FontWeight="SemiBold"
           Click="TradeWithPlayerButton_Click"
 Tag="{Binding}">
     <Button.Resources>
      <ResourceDictionary>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
   </ResourceDictionary>
   </Button.Resources>
</Button>
   </Grid>
     </Border>
          </DataTemplate>
       </ListView.ItemTemplate>
         </ListView>
    </Grid>
         </Border>

            <!-- TRADE REQUESTS SECTION -->
            <Border Grid.Column="2"
         Background="#1F2937"
         CornerRadius="12"
           BorderThickness="2"
        BorderBrush="#374151"
     Padding="20">
    <Grid>
 <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/>
                   <RowDefinition Height="*"/>
       </Grid.RowDefinitions>

          <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,15">
        <TextBlock Text="?? Trade Requests"
          FontSize="20"
         FontWeight="Bold"
                 Foreground="White"/>
      <Border Background="#EF4444"
        CornerRadius="12"
               Padding="8,4"
            x:Name="NotificationBadge"
   Visibility="Collapsed">
    <TextBlock x:Name="NotificationCount"
   Text="0"
             Foreground="White"
   FontSize="12"
            FontWeight="Bold"/>
        </Border>
      </StackPanel>

       <!-- Trade Requests List -->
     <ScrollViewer Grid.Row="1">
          <ListView x:Name="TradeRequestsListView"
          Background="Transparent"
          SelectionMode="None">
 <ListView.ItemTemplate>
      <DataTemplate>
<Border Background="#111827"
                CornerRadius="8"
     Padding="15"
             Margin="0,0,0,10">
   <StackPanel Spacing="10">
              <!-- Header -->
       <Grid>
      <TextBlock Text="{Binding SenderName}"
         Foreground="White"
     FontSize="16"
  FontWeight="Bold"/>
         <TextBlock Text="{Binding CreatedDate}"
      Foreground="#9CA3AF"
         FontSize="11"
         HorizontalAlignment="Right"
             VerticalAlignment="Center"/>
  </Grid>

      <!-- Trade Details -->
        <Grid>
           <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
    <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

        <!-- They Give -->
      <StackPanel>
      <TextBlock Text="They Offer:"
                Foreground="#9CA3AF"
   FontSize="11"
        Margin="0,0,0,5"/>
     <Border Background="#1F2937"
          CornerRadius="6"
         Padding="10">
    <StackPanel>
<TextBlock Text="{Binding SenderItemName}"
        Foreground="White"
        FontSize="13"
        FontWeight="SemiBold"/>
        <TextBlock Foreground="#10B981" FontSize="12">
       <Run Text="x"/>
    <Run Text="{Binding SenderQuantity}"/>
       </TextBlock>
           </StackPanel>
   </Border>
  </StackPanel>

 <!-- Arrow -->
               <TextBlock Text="?"
  Grid.Column="1"
         FontSize="20"
         Foreground="#60A5FA"
                VerticalAlignment="Center"
 Margin="10,0"/>

             <!-- You Give -->
                   <StackPanel Grid.Column="2">
     <TextBlock Text="You Give:"
             Foreground="#9CA3AF"
    FontSize="11"
                Margin="0,0,0,5"/>
           <Border Background="#1F2937"
      CornerRadius="6"
  Padding="10">
       <StackPanel>
      <TextBlock Text="{Binding ReceiverItemName}"
     Foreground="White"
             FontSize="13"
  FontWeight="SemiBold"/>
         <TextBlock Foreground="#10B981" FontSize="12">
            <Run Text="x"/>
 <Run Text="{Binding ReceiverQuantity}"/>
    </TextBlock>
          </StackPanel>
         </Border>
  </StackPanel>
            </Grid>

        <!-- Actions -->
        <Grid>
            <Grid.ColumnDefinitions>
               <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

      <Button Content="? Accept"
           Background="#10B981"
   Foreground="White"
HorizontalAlignment="Stretch"
             CornerRadius="6"
 Padding="0,8"
           Click="AcceptTradeButton_Click"
          Tag="{Binding}">
    <Button.Resources>
           <ResourceDictionary>
 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
               <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
      </ResourceDictionary>
         </Button.Resources>
       </Button>

       <Button Content="? Decline"
          Grid.Column="2"
     Background="#EF4444"
                 Foreground="White"
       HorizontalAlignment="Stretch"
  CornerRadius="6"
  Padding="0,8"
        Click="DeclineTradeButton_Click"
        Tag="{Binding}">
         <Button.Resources>
          <ResourceDictionary>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
     </ResourceDictionary>
  </Button.Resources>
      </Button>
           </Grid>
        </StackPanel>
   </Border>
</DataTemplate>
   </ListView.ItemTemplate>
           </ListView>
       </ScrollViewer>
     </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
