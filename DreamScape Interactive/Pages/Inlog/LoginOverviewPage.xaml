<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.Inlog.LoginOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScape_Interactive.Pages.Inlog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Background="#111827">

        <!-- Subtle Accent Glow -->
        <Ellipse Width="600"
                 Height="600"
                 Fill="#4F46E5"
                 Opacity="0.08"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-200,-200,0,0"/>

        <Ellipse Width="500"
                 Height="500"
                 Fill="#10B981"
                 Opacity="0.06"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-200,-200"/>

        <!-- Login Card -->
        <Border Width="440"
                Padding="40"
                CornerRadius="16"
                Background="#1F2937"
                BorderBrush="#374151"
                BorderThickness="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>

            <StackPanel Spacing="24">

                <!-- Logo / Title -->
                <StackPanel Spacing="8">
                    <TextBlock Text="🎮 DreamScape"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Interactive Trading Platform"
                               FontSize="14"
                               Foreground="#9CA3AF"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Divider -->
                <Rectangle Height="1"
                           Fill="#374151"
                           Margin="0,8,0,8"/>

                <!-- Username -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Email"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#D1D5DB"/>
                    <TextBox x:Name="EmailBox"
                             PlaceholderText="Enter your email"
                             Background="#111827"
                             Foreground="White"
                             BorderBrush="#374151"
                             BorderThickness="2"
                             CornerRadius="8"
                             Height="44"
                             Padding="12,8"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Password"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#D1D5DB"/>
                    <PasswordBox x:Name="PasswordBox"
                                 PlaceholderText="Enter your password"
                                 Background="#111827"
                                 Foreground="White"
                                 BorderBrush="#374151"
                                 BorderThickness="2"
                                 CornerRadius="8"
                                 Height="44"
                                 Padding="12,8"/>
                </StackPanel>

                <!-- Sign In Button -->
                <Button Content="Sign In"
                        Click="Login_Click"
                        Height="48"
                        FontWeight="SemiBold"
                        FontSize="15"
                        CornerRadius="8"
                        Background="#10B981"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <!-- Development Buttons -->
                <StackPanel Spacing="12">
                    <Rectangle Height="1"
                               Fill="#374151"/>

                    <TextBlock Text="Development Login"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#6B7280"
                               HorizontalAlignment="Center"/>

                    <Button Content="DEV Sign In (Admin)"
                            Click="DevLogin_Click"
                            Height="42"
                            FontWeight="SemiBold"
                            FontSize="13"
                            CornerRadius="8"
                            Background="#374151"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0">
                        <Button.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>

                    <Button Content="DEV Sign In (Player)"
                            Click="DevLoginPlayer_Click"
                            Height="42"
                            FontWeight="SemiBold"
                            FontSize="13"
                            CornerRadius="8"
                            Background="#374151"
                            Foreground="White"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0">
                        <Button.Resources>
                            <ResourceDictionary>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Status / Error Message -->
                <TextBlock x:Name="ErrorMessage"
                           TextAlignment="Center"
                           Foreground="#EF4444"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Don't have an account?"
                           Foreground="#9CA3AF"
                           FontSize="12"
                           HorizontalAlignment="Center"/>

                <Button Content="Create an account"
                        Click="CreateAccount_Click"
                        Height="36"
                        FontWeight="SemiBold"
                        FontSize="13"
                        CornerRadius="8"
                        Background="#2563EB"
                        Foreground="White"
                        HorizontalAlignment="Center"
                        BorderThickness="0"/>
            </StackPanel>
        </Border>

    </Grid>
</Page>
