<?xml version="1.0" encoding="utf-8"?>
<Page
 x:Class="DreamScape_Interactive.Pages.Player.LeaderboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 mc:Ignorable="d">

 <Grid Background="#111827">
 <Grid.RowDefinitions>
 <RowDefinition Height="70" />
 <RowDefinition Height="Auto" />
 <RowDefinition Height="*" />
 </Grid.RowDefinitions>

 <Grid Background="#1F2937" Padding="20">
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="Auto" />
 <ColumnDefinition Width="*" />
 </Grid.ColumnDefinitions>
 <Button Content="← Back" Background="#374151" Foreground="White" Padding="10,5" Margin="0,0,20,0" VerticalAlignment="Center" Click="BackButton_Click"/>
 <TextBlock Grid.Column="1" Text="?? Leaderboard" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
 </Grid>

 <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20" Spacing="10">
 <TextBox x:Name="SearchBox" Width="300" Height="40" PlaceholderText="Search players..." TextChanged="SearchBox_TextChanged" Background="#1F2937" Foreground="White" BorderBrush="#374151" BorderThickness="2" Padding="10"/>
 </StackPanel>

 <ScrollViewer Grid.Row="2" Margin="20">
 <ListView x:Name="LeaderboardListView" Background="Transparent" SelectionMode="None">
 <ListView.ItemTemplate>
 <DataTemplate>
 <Border Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#374151" BorderThickness="2">
 <Grid>
 <Grid.ColumnDefinitions>
 <ColumnDefinition Width="Auto" />
 <ColumnDefinition Width="*" />
 <ColumnDefinition Width="Auto" />
 </Grid.ColumnDefinitions>

 <TextBlock Text="{Binding Rank}" FontSize="20" Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" Width="40"/>

 <StackPanel Grid.Column="1">
 <TextBlock Text="{Binding Username}" Foreground="White" FontSize="16" FontWeight="Bold"/>
 <TextBlock Text="{Binding Email}" Foreground="#9CA3AF" FontSize="12"/>
 </StackPanel>

 <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="12">
 <StackPanel>
 <TextBlock Text="Level" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center"/>
 <TextBlock Text="{Binding Level}" Foreground="#FBBF24" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
 </StackPanel>
 <StackPanel>
 <TextBlock Text="XP" Foreground="#9CA3AF" FontSize="12" HorizontalAlignment="Center"/>
 <TextBlock Text="{Binding TotalXP}" Foreground="#10B981" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
 </StackPanel>
 </StackPanel>
 </Grid>
 </Border>
 </DataTemplate>
 </ListView.ItemTemplate>
 </ListView>
 </ScrollViewer>
 </Grid>
</Page>