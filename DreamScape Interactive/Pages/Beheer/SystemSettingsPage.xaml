<?xml version="1.0" encoding="utf-8"?>
<Page
 x:Class="DreamScape_Interactive.Pages.Beheer.SystemSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

<Grid.ColumnDefinitions>
     <ColumnDefinition Width="250"/>
 <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#1F2937">
       <StackPanel Margin="20">

  <StackPanel Margin="0,0,0,40">
     <TextBlock Text="?? DreamScape"
FontSize="24"
        FontWeight="Bold"
  Foreground="White"/>
        <TextBlock Text="Admin Panel"
      FontSize="12"
  Foreground="#9CA3AF"
       Margin="0,5,0,0"/>
 </StackPanel>

     <Button Content="?? Dashboard"
 Margin="0,5"
        Padding="15,12"
   Background="#374151"
 Foreground="White"
 CornerRadius="8"
  FontWeight="SemiBold"
BorderThickness="0"
  Click="BeheerOverviewButton_Click">
     <Button.Resources>
          <ResourceDictionary>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
      </ResourceDictionary>
   </Button.Resources>
 </Button>

<Button Content="?? Gebruikers"
  Margin="0,5"
Padding="15,12"
   Background="#374151"
     Foreground="White"
CornerRadius="8"
FontWeight="SemiBold"
 BorderThickness="0"
Click="UserButton_Click">
 <Button.Resources>
 <ResourceDictionary>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
 </ResourceDictionary>
  </Button.Resources>
 </Button>

  <Button Content="?? Items"
   Margin="0,5"
     Padding="15,12"
     Background="#374151"
     Foreground="White"
  CornerRadius="8"
   FontWeight="SemiBold"
       BorderThickness="0"
Click="ItemsButton_Click">
   <Button.Resources>
   <ResourceDictionary>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
 <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
</ResourceDictionary>
  </Button.Resources>
</Button>

       <Button Content="?? Trades"
Margin="0,5"
    Padding="15,12"
    Background="#374151"
    Foreground="White"
  CornerRadius="8"
FontWeight="SemiBold"
  BorderThickness="0"
Click="TradesButton_Click">
   <Button.Resources>
   <ResourceDictionary>
  <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
 <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
 </ResourceDictionary>
        </Button.Resources>
 </Button>

   <Button Content="?? Settings"
      Margin="0,5"
    Padding="15,12"
 Background="#10B981"
  Foreground="White"
     CornerRadius="8"
     FontWeight="SemiBold"
     BorderThickness="0"
     Click="SettingsButton_Click">
 <Button.Resources>
      <ResourceDictionary>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
     </ResourceDictionary>
 </Button.Resources>
            </Button>

  <Button x:Name="Logout"
      Content="?? Uitloggen"
 Margin="0,60,0,0"
  Padding="15,12"
    Background="#EF4444"
   Foreground="White"
      CornerRadius="8"
 FontWeight="SemiBold"
  BorderThickness="0"
      Click="Logout_Click">
 <Button.Resources>
  <ResourceDictionary>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
        </ResourceDictionary>
  </Button.Resources>
 </Button>

   </StackPanel>
 </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">

   <Grid.RowDefinitions>
      <RowDefinition Height="80"/>
   <RowDefinition Height="*"/>
 </Grid.RowDefinitions>

  <!-- Topbar -->
      <Grid Background="#1F2937" Padding="30,0">
     <TextBlock Text="?? System Settings"
      FontSize="28"
 FontWeight="Bold"
    Foreground="White"
  VerticalAlignment="Center"/>
</Grid>

         <!-- Settings Content -->
            <ScrollViewer Grid.Row="1" Margin="30,20,30,30">
        <StackPanel Spacing="20">

   <!-- XP Settings -->
         <Border Background="#1F2937"
    CornerRadius="12"
BorderThickness="2"
      BorderBrush="#374151"
Padding="25">
   <StackPanel Spacing="15">
     <TextBlock Text="? Experience Settings"
      FontSize="20"
   FontWeight="Bold"
Foreground="White"/>

      <Rectangle Height="1" Fill="#374151"/>

       <StackPanel Spacing="10">
<TextBlock Text="XP per Trade"
       Foreground="#D1D5DB"
FontSize="14"
    FontWeight="SemiBold"/>
     <NumberBox x:Name="XPPerTradeBox"
  Value="50"
      Minimum="1"
 Maximum="1000"
            SpinButtonPlacementMode="Inline"
     Height="44"/>
      </StackPanel>

    <StackPanel Spacing="10">
        <TextBlock Text="Starting XP Requirement"
   Foreground="#D1D5DB"
      FontSize="14"
   FontWeight="SemiBold"/>
   <NumberBox x:Name="StartingXPBox"
  Value="100"
      Minimum="50"
       Maximum="500"
 SpinButtonPlacementMode="Inline"
  Height="44"/>
      </StackPanel>

 <StackPanel Spacing="10">
  <TextBlock Text="XP Multiplier per Level"
     Foreground="#D1D5DB"
   FontSize="14"
FontWeight="SemiBold"/>
   <NumberBox x:Name="XPMultiplierBox"
    Value="1.5"
     Minimum="1.1"
    Maximum="3.0"
        SmallChange="0.1"
LargeChange="0.5"
     SpinButtonPlacementMode="Inline"
  Height="44"/>
   </StackPanel>

   <Button Content="?? Save XP Settings"
      Background="#10B981"
  Foreground="White"
      Padding="15,10"
            CornerRadius="8"
    Click="SaveXPSettingsButton_Click">
         <Button.Resources>
   <ResourceDictionary>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
       <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
        </ResourceDictionary>
          </Button.Resources>
 </Button>
 </StackPanel>
 </Border>

    <!-- Database Management -->
      <Border Background="#1F2937"
    CornerRadius="12"
   BorderThickness="2"
       BorderBrush="#374151"
 Padding="25">
          <StackPanel Spacing="15">
<TextBlock Text="??? Database Management"
 FontSize="20"
  FontWeight="Bold"
        Foreground="White"/>

 <Rectangle Height="1" Fill="#374151"/>

 <StackPanel Spacing="15">
          <TextBlock Text="?? Danger Zone"
Foreground="#EF4444"
          FontSize="14"
      FontWeight="Bold"/>

   <Button Content="?? Reset All Trade Requests"
Background="#F59E0B"
  Foreground="White"
       Padding="15,10"
       CornerRadius="8"
      Click="ResetTradeRequestsButton_Click">
  <Button.Resources>
 <ResourceDictionary>
           <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#D97706"/>
     <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B45309"/>
</ResourceDictionary>
 </Button.Resources>
   </Button>

       <Button Content="??? Clear Trade History"
Background="#EF4444"
   Foreground="White"
Padding="15,10"
  CornerRadius="8"
Click="ClearTradeHistoryButton_Click">
       <Button.Resources>
  <ResourceDictionary>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
      </ResourceDictionary>
         </Button.Resources>
 </Button>

        <TextBlock Text="These actions cannot be undone!"
      Foreground="#9CA3AF"
FontSize="11"
  FontStyle="Italic"/>
   </StackPanel>
</StackPanel>
      </Border>

     <!-- Statistics Export -->
<Border Background="#1F2937"
     CornerRadius="12"
       BorderThickness="2"
BorderBrush="#374151"
Padding="25">
    <StackPanel Spacing="15">
        <TextBlock Text="?? Statistics &amp; Reports"
         FontSize="20"
       FontWeight="Bold"
  Foreground="White"/>

    <Rectangle Height="1" Fill="#374151"/>

 <Grid>
  <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
  <ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>

    <StackPanel Spacing="10">
   <TextBlock Text="Database Statistics"
      Foreground="#D1D5DB"
FontSize="14"
      FontWeight="SemiBold"/>
  <TextBlock x:Name="DBStatsText"
         Text="Loading..."
  Foreground="#9CA3AF"
      FontSize="12"
     TextWrapping="Wrap"/>
      </StackPanel>

<Button Content="?? Export Report"
    Grid.Column="1"
Background="#2563EB"
Foreground="White"
      Padding="15,10"
    CornerRadius="8"
   HorizontalAlignment="Right"
        Click="ExportReportButton_Click">
 <Button.Resources>
         <ResourceDictionary>
 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>
       </ResourceDictionary>
 </Button.Resources>
</Button>
  </Grid>
     </StackPanel>
  </Border>

        </StackPanel>
   </ScrollViewer>

        </Grid>
    </Grid>
</Page>
