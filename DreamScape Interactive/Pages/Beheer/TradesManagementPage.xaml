<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.Beheer.TradesManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

        <Grid.ColumnDefinitions>
       <ColumnDefinition Width="250"/>
     <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#1F2937">
     <StackPanel Margin="20">

      <StackPanel Margin="0,0,0,40">
   <TextBlock Text="?? DreamScape"
      FontSize="24"
     FontWeight="Bold"
Foreground="White"/>
   <TextBlock Text="Admin Panel"
      FontSize="12"
      Foreground="#9CA3AF"
         Margin="0,5,0,0"/>
     </StackPanel>

    <Button Content="?? Dashboard"
     Margin="0,5"
            Padding="15,12"
    Background="#374151"
         Foreground="White"
      CornerRadius="8"
      FontWeight="SemiBold"
            BorderThickness="0"
       Click="BeheerOverviewButton_Click">
         <Button.Resources>
   <ResourceDictionary>
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
     </ResourceDictionary>
 </Button.Resources>
      </Button>

       <Button Content="?? Gebruikers"
      Margin="0,5"
    Padding="15,12"
     Background="#374151"
  Foreground="White"
      CornerRadius="8"
       FontWeight="SemiBold"
        BorderThickness="0"
    Click="UserButton_Click">
         <Button.Resources>
   <ResourceDictionary>
 <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
   <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
     </ResourceDictionary>
        </Button.Resources>
           </Button>

  <Button Content="?? Items"
     Margin="0,5"
   Padding="15,12"
      Background="#374151"
  Foreground="White"
  CornerRadius="8"
       FontWeight="SemiBold"
      BorderThickness="0"
   Click="ItemsButton_Click">
  <Button.Resources>
     <ResourceDictionary>
   <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
        </ResourceDictionary>
</Button.Resources>
      </Button>

            <Button Content="?? Trades"
  Margin="0,5"
    Padding="15,12"
     Background="#10B981"
         Foreground="White"
      CornerRadius="8"
   FontWeight="SemiBold"
   BorderThickness="0"
     Click="TradesButton_Click">
       <Button.Resources>
    <ResourceDictionary>
     <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
         <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
  </ResourceDictionary>
     </Button.Resources>
     </Button>

          <Button x:Name="Logout"
   Content="?? Uitloggen"
     Margin="0,60,0,0"
  Padding="15,12"
Background="#EF4444"
    Foreground="White"
    CornerRadius="8"
FontWeight="SemiBold"
    BorderThickness="0"
  Click="Logout_Click">
     <Button.Resources>
        <ResourceDictionary>
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
     <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
 </ResourceDictionary>
         </Button.Resources>
      </Button>

            </StackPanel>
 </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">

   <Grid.RowDefinitions>
  <RowDefinition Height="80"/>
     <RowDefinition Height="Auto"/>
         <RowDefinition Height="*"/>
 </Grid.RowDefinitions>

   <!-- Topbar -->
   <Grid Background="#1F2937" Padding="30,0">
<TextBlock Text="?? Trade History"
    FontSize="28"
  FontWeight="Bold"
    Foreground="White"
     VerticalAlignment="Center"/>
 </Grid>

   <!-- Stats Summary -->
        <Grid Grid.Row="1" Margin="30,20,30,10">
        <Grid.ColumnDefinitions>
   <ColumnDefinition/>
    <ColumnDefinition/>
   <ColumnDefinition/>
            <ColumnDefinition/>
 </Grid.ColumnDefinitions>

   <!-- Total Trades -->
   <Border Background="#1F2937"
      CornerRadius="10"
  Padding="15"
 Margin="0,0,5,0"
  BorderBrush="#374151"
    BorderThickness="2">
  <StackPanel>
    <TextBlock Text="Total Trades"
  Foreground="#9CA3AF"
    FontSize="12"/>
      <TextBlock x:Name="TotalTradesText"
        Text="0"
       FontSize="32"
      FontWeight="Bold"
Foreground="White"
    Margin="0,5,0,0"/>
  </StackPanel>
      </Border>

     <!-- Pending Requests -->
            <Border Background="#1F2937"
   CornerRadius="10"
  Padding="15"
Margin="5,0"
   BorderBrush="#374151"
  BorderThickness="2"
 Grid.Column="1">
   <StackPanel>
     <TextBlock Text="Pending"
      Foreground="#9CA3AF"
   FontSize="12"/>
   <TextBlock x:Name="PendingTradesText"
     Text="0"
FontSize="32"
   FontWeight="Bold"
       Foreground="#F59E0B"
  Margin="0,5,0,0"/>
   </StackPanel>
        </Border>

     <!-- Accepted -->
        <Border Background="#1F2937"
     CornerRadius="10"
    Padding="15"
   Margin="5,0"
  BorderBrush="#374151"
    BorderThickness="2"
   Grid.Column="2">
      <StackPanel>
    <TextBlock Text="Accepted"
      Foreground="#9CA3AF"
    FontSize="12"/>
   <TextBlock x:Name="AcceptedTradesText"
  Text="0"
     FontSize="32"
    FontWeight="Bold"
  Foreground="#10B981"
          Margin="0,5,0,0"/>
          </StackPanel>
       </Border>

 <!-- Declined -->
 <Border Background="#1F2937"
     CornerRadius="10"
   Padding="15"
      Margin="5,0,0,0"
    BorderBrush="#374151"
BorderThickness="2"
    Grid.Column="3">
        <StackPanel>
      <TextBlock Text="Declined"
     Foreground="#9CA3AF"
    FontSize="12"/>
    <TextBlock x:Name="DeclinedTradesText"
     Text="0"
 FontSize="32"
FontWeight="Bold"
     Foreground="#EF4444"
     Margin="0,5,0,0"/>
     </StackPanel>
     </Border>
     </Grid>

        <!-- Trade History List -->
     <ScrollViewer Grid.Row="2" Margin="30,0,30,30">
     <ListView x:Name="TradesListView"
       Background="Transparent"
     SelectionMode="None">
    <ListView.ItemTemplate>
  <DataTemplate>
     <Border Background="#1F2937"
 CornerRadius="12"
    BorderThickness="2"
  BorderBrush="#374151"
 Padding="20"
 Margin="0,0,0,15">

 <Grid>
     <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
  <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

          <!-- Header -->
  <Grid Margin="0,0,0,15">
   <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding StatusIcon}"
    FontSize="20"/>
<TextBlock Text="{Binding Status}"
      Foreground="{Binding StatusColor}"
   FontSize="16"
FontWeight="Bold"
   VerticalAlignment="Center"/>
   </StackPanel>

  <TextBlock Text="{Binding Date}"
     Foreground="#9CA3AF"
     FontSize="12"
       HorizontalAlignment="Right"
  VerticalAlignment="Center"/>
  </Grid>

     <!-- Players Info -->
  <Grid Grid.Row="1" Margin="0,0,0,15">
       <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*"/>
   <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
 </Grid.ColumnDefinitions>

   <!-- Player 1 -->
        <StackPanel>
    <TextBlock Text="Sender"
         Foreground="#9CA3AF"
   FontSize="11"
    Margin="0,0,0,5"/>
    <Border Background="#111827"
       CornerRadius="8"
           Padding="12">
     <StackPanel>
      <TextBlock Text="{Binding Player1Name}"
       Foreground="White"
        FontSize="14"
FontWeight="SemiBold"/>
  <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
         <TextBlock Text="??" FontSize="12"/>
<TextBlock Text="{Binding Player1ItemName}"
       Foreground="#9CA3AF"
 FontSize="12"/>
     <TextBlock Text="×" Foreground="#9CA3AF" FontSize="12"/>
        <TextBlock Text="{Binding Player1Quantity}"
Foreground="#10B981"
       FontSize="12"
  FontWeight="SemiBold"/>
  </StackPanel>
      </StackPanel>
     </Border>
                </StackPanel>

  <!-- Arrow -->
   <TextBlock Text="?"
  Grid.Column="1"
  FontSize="24"
       Foreground="#60A5FA"
   VerticalAlignment="Center"
      Margin="15,0"/>

  <!-- Player 2 -->
   <StackPanel Grid.Column="2">
 <TextBlock Text="Receiver"
  Foreground="#9CA3AF"
     FontSize="11"
Margin="0,0,0,5"/>
<Border Background="#111827"
          CornerRadius="8"
       Padding="12">
       <StackPanel>
 <TextBlock Text="{Binding Player2Name}"
    Foreground="White"
           FontSize="14"
       FontWeight="SemiBold"/>
      <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,3,0,0">
     <TextBlock Text="??" FontSize="12"/>
    <TextBlock Text="{Binding Player2ItemName}"
    Foreground="#9CA3AF"
       FontSize="12"/>
        <TextBlock Text="×" Foreground="#9CA3AF" FontSize="12"/>
       <TextBlock Text="{Binding Player2Quantity}"
   Foreground="#10B981"
FontSize="12"
  FontWeight="SemiBold"/>
   </StackPanel>
 </StackPanel>
   </Border>
     </StackPanel>
   </Grid>

<!-- XP Award -->
      <Border Grid.Row="2"
     Background="#111827"
   CornerRadius="8"
            Padding="12"
        HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBlock Text="?" FontSize="16"/>
      <TextBlock Text="XP Awarded:"
    Foreground="#9CA3AF"
  FontSize="13"/>
         <TextBlock Text="{Binding XPAwarded}"
  Foreground="#10B981"
       FontSize="14"
          FontWeight="Bold"/>
      </StackPanel>
     </Border>

   </Grid>
        </Border>
   </DataTemplate>
  </ListView.ItemTemplate>
  </ListView>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>
