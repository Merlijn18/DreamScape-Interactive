<Page
    x:Class="DreamScape_Interactive.Pages.Player.UserDashboard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

        <!-- GRID DEFINITIES -->
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- Topbar -->
            <RowDefinition Height="Auto"/>
            <!-- Quick Actions -->
            <RowDefinition Height="Auto"/>
            <!-- Player Stats -->
            <RowDefinition Height="*"/>
            <!-- Inventory / Content -->
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <Grid Background="#1F2937">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DreamScape Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="20,0"/>

            <Button Grid.Column="1"
                    Content="Uitloggen"
                    Background="#EF4444"
                    Foreground="White"
                    Margin="0,0,20,0"
                    Padding="10,5"
                    VerticalAlignment="Center"
                    Click="Logout_Click"/>
        </Grid>

        <!-- QUICK ACTION BUTTONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="20"
                    Spacing="15">

            <Button Content="📦 Inventory"
                    Background="#374151"
                    Foreground="White"
                    Padding="15,10"
                    MinWidth="180"
                    CornerRadius="8"
                    Click="InventoryButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>

            <Button Content="🤝 Trading Hub"
                    Background="#10B981"
                    Foreground="White"
                    Padding="15,10"
                    MinWidth="180"
                    CornerRadius="8"
                    Click="TradingButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>

            <Button Content="🏆 Leaderboard"
                    Background="#2563EB"
                    Foreground="White"
                    Padding="15,10"
                    MinWidth="180"
                    CornerRadius="8"
                    Click="LeaderboardButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>

            <!-- DAILY REWARD BUTTON -->
            <Button Content="🎁 Daily Loot"
                    Background="#FBBF24"
                    Foreground="White"
                    Padding="15,10"
                    MinWidth="180"
                    CornerRadius="8"
                    Click="DailyLootButton_Click">
                <Button.Resources>
                    <ResourceDictionary>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F59E0B"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D97706"/>
                    </ResourceDictionary>
                </Button.Resources>
            </Button>
        </StackPanel>

        <!-- PLAYER STATS -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Level -->
            <Border Background="#1F2937" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="Level" Foreground="Gray" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="⭐" FontSize="24"/>
                        <TextBlock x:Name="LevelText" Text="1" Foreground="#FBBF24" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- XP Progress -->
            <Border Grid.Column="1" Background="#1F2937" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="Experience" Foreground="Gray" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,5,0,0">
                        <TextBlock Text="✨" FontSize="20"/>
                        <TextBlock x:Name="XPText" Text="0 / 100" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <ProgressBar x:Name="XPProgressBar" Height="8" Value="0" Maximum="100" Foreground="#10B981" Background="#374151" Margin="0,8,0,0" CornerRadius="4"/>
                </StackPanel>
            </Border>

            <!-- Trades Completed -->
            <Border Grid.Column="2" Background="#1F2937" CornerRadius="10" Padding="20" Margin="10">
                <StackPanel>
                    <TextBlock Text="Trades Completed" Foreground="Gray" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="🤝" FontSize="24"/>
                        <TextBlock x:Name="TradesText" Text="0" Foreground="#10B981" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- INVENTORY / MAIN CONTENT -->
        <Grid Grid.Row="3" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Inventory Preview"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="10"/>

            <ListView Grid.Row="1" Background="#1F2937" Margin="0,10,0,0">
                <ListView.Header>
                    <Grid Padding="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Item" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Aantal" Grid.Column="1" Foreground="White" FontWeight="Bold"/>
                        <TextBlock Text="Acties" Grid.Column="2" Foreground="White" FontWeight="Bold"/>
                    </Grid>
                </ListView.Header>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Sword of Valor" Foreground="White"/>
                            <TextBlock Text="1" Grid.Column="1" Foreground="White"/>
                            <StackPanel Orientation="Horizontal" Grid.Column="2" Spacing="5">
                                <Button Content="Use" Background="#2563EB" Foreground="White" Padding="5,2"/>
                                <Button Content="Sell" Background="#EF4444" Foreground="White" Padding="5,2"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

    </Grid>
</Page>