<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DreamScape_Interactive.Pages.Beheer.BeheerUserOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DreamScape_Interactive.Pages.Beheer"
    xmlns:localdata="using:DreamScape_Interactive.Data.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="#111827">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#1F2937">
            <StackPanel Margin="20">

                <StackPanel Margin="0,0,0,40">
                    <TextBlock Text="🎮 DreamScape"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Admin Panel"
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Content="📊 Dashboard"
                        Margin="0,5"
                        Padding="15,12"
                        Background="#374151"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="BeheerOverviewButton_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <Button Content="👥 Gebruikers"
                        Margin="0,5"
                        Padding="15,12"
                        Background="#10B981"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="UserButton_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#059669"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#047857"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <Button Content="🤝 Trades"
                        Margin="0,5"
                        Padding="15,12"
                        Background="#374151"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="TradesButton_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <Button Content="⚙️ Instellingen"
                        Margin="0,5"
                        Padding="15,12"
                        Background="#374151"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="SettingsButton_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#4B5563"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#6B7280"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

                <Button x:Name="Logout"
                        Content="🚪 Uitloggen"
                        Margin="0,60,0,0"
                        Padding="15,12"
                        Background="#EF4444"
                        Foreground="White"
                        CornerRadius="8"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Click="Logout_Click">
                    <Button.Resources>
                        <ResourceDictionary>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Grid Background="#1F2937" Padding="30,0">
                <TextBlock Text="👥 User Management"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="30,20,30,10">
                <TextBox x:Name="userSearchTextBox"
                         PlaceholderText="🔍 Search users by name or email..."
                         TextChanged="userSearchTextBox_TextChanged"
                         Background="#1F2937"
                         Foreground="White"
                         PlaceholderForeground="#9CA3AF"
                         BorderBrush="#374151"
                         BorderThickness="2"
                         CornerRadius="8"
                         Height="44"
                         Padding="15,10"/>
            </Grid>

            <!-- User list -->
            <ListView Grid.Row="2"
                      Margin="30,0,30,30"
                      x:Name="BeheerUserList"
                      Background="Transparent"
                      SelectionMode="None">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="localdata:User">
                        <Border Background="#1F2937"
                                CornerRadius="12"
                                BorderThickness="2"
                                BorderBrush="#374151"
                                Padding="20"
                                Margin="0,0,0,15">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- User Avatar/ID -->
                                <Border Background="#374151"
                                       CornerRadius="8"
                                       Width="50"
                                       Height="50">
                                    <TextBlock Text="{Binding Id}"
                                               Foreground="#FBBF24"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- User Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
                                    <TextBlock Text="{Binding Username}"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="Bold"/>

                                    <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="📧" FontSize="14"/>
                                            <TextBlock Text="{Binding Email}"
                                                       Foreground="#9CA3AF"
                                                       FontSize="14"/>
                                        </StackPanel>

                                        <TextBlock Text="|" Foreground="#6B7280"/>

                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="🎭" FontSize="14"/>
                                            <TextBlock Text="{Binding Role}"
                                                       Foreground="#60A5FA"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <TextBlock Text="|" Foreground="#6B7280"/>

                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="⭐" FontSize="14"/>
                                            <TextBlock Text="{Binding Level}"
                                                       Foreground="#FBBF24"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Created Date -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="Created"
                                               Foreground="#9CA3AF"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding CreatedAt}"
                                               Foreground="White"
                                               FontSize="13"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="3"
                                             Orientation="Horizontal"
                                             Spacing="10">

                                    <Button Content="📦 Inv"
                                            Background="#2563EB"
                                            Foreground="White"
                                            Padding="12,8"
                                            CornerRadius="6"
                                            FontWeight="SemiBold"
                                            Tag="{Binding}"
                                            Click="ViewInventoryButton_Click">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1D4ED8"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF"/>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                    </Button>

                                    <Button Content="🗑️ Delete"
                                            Background="#EF4444"
                                            Foreground="White"
                                            Padding="12,8"
                                            CornerRadius="6"
                                            FontWeight="SemiBold"
                                            Tag="{Binding}"
                                            Click="DeleteUserButton_Click">
                                        <Button.Resources>
                                            <ResourceDictionary>
                                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DC2626"/>
                                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#B91C1C"/>
                                            </ResourceDictionary>
                                        </Button.Resources>
                                    </Button>

                                </StackPanel>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>
    </Grid>
</Page>